{
  "name": "setorra",
  "version": "0.1.1",
  "description": "Configure automated API migration for a GitHub repository.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yospy/setorra-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Yospy/setorra-cli/issues"
  },
  "homepage": "https://github.com/Yospy/setorra-cli#readme",
  "bin": {
    "setorra": "dist/setorra.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "tsc --project tsconfig.json",
    "test": "node --test .tsbuild/tests/*.test.js",
    "fixtures:cloud-agent-v1": "tsc --project tsconfig.json && node scripts/generate-cloud-agent-fixtures.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsup": "8.5.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
